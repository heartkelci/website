---
import { Image } from "astro:assets";
import pinkswirlImage from "../assets/img/pink-swirl.png";
---

<footer
  class="border-rose/20 relative overflow-hidden border-t px-6 py-10 text-center"
>
  <Image
    src={pinkswirlImage}
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute right-0 bottom-0 h-96 w-auto select-none"
    style="transform:translate(5%, 20%)"
    format="webp"
  /><p
    class="font-body relative z-10 text-sm tracking-widest text-[#7A7A7A] uppercase"
    x-data="{year: new Date().getFullYear()}"
  >
    © <span x-html="year"></span> Kelci Heart · kelciheart.love
  </p>
</footer>
